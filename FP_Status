import random

# Board setup
def make_board():
    #Create the board 4x4
    board = []
    for row in range(4):
        #return a board filled with zeros so it appears empty
        board.append([0, 0, 0, 0])
    return board

def print_board(board):
    #Prints the board in a readable grid format for us to see 
    for row in board:
        print(row)


# Tile placement
def get_empty_cells(board):
    #Returns a list of rows and column tuples for all of the 'empty' (zero numbered) cells
    empty = []
    for row in range(len(board)):
        for col in range(len(board[row])):
            if board[row][col] == 0:
                empty.append((row, col))
    return empty

def place_tile(board):
    #places a 2 or sometimes a 4 into a random empty cell randomly to get more tile numbers to appear
    empty = get_empty_cells(board)
    if empty:
        row, col = random.choice(empty)
        board[row][col] = 2 if random.random() < 0.9 else 4


# the main sliding logic

def slide_row_left(row):
    #slide all nonzero tiles in the row to the left and then combine all of the equal tiles which are adjacent to eachother
    #then returns the new row values, an example is: [0, 2, 2, 4] -> [4, 4, 0, 0]
    
    # step 1: remove the zeros to make just tiles with a value next to eachother
    tiles = [val for val in row if val != 0]

    # step 2: merge the adjacent cells which are equal to eachother 
    merged = []
    i = 0
    while i < len(tiles):
        if i + 1 < len(tiles) and tiles[i] == tiles[i + 1]:
            merged.append(tiles[i] * 2)   # merge the tiles
            i += 2                         # skip both tiles
        else:
            merged.append(tiles[i])
            i += 1

    # step 3:refill the zeros on the right hand side after the slide to the left to remake the line of the board equal to 4 
    while len(merged) < 4:
        merged.append(0)

    return merged


# Code to slide in all four directions
    # rather than writing four separate merges with different code, we changed the board directionsso that every move becomes a "slide left" then we change it back
        #Right: flip each row, slide left, reverse back
        #up:transpose the board, slide left, transpose back
        #down: transpose, reverse each row, slide left, reverse back, transpose back


def reverse_rows(board):
    #this code returns the board where every row is reversed so the left and right sides are flipped 
    return [row[::-1] for row in board]

def transpose(board):
    # this code returns the board as transposed so that the rows become columns and the columns have become rows 
    return [list(row) for row in zip(*board)]

def slide_left(board):
    #this code slides all the tiles on the board to the left and returns the new board
    return [slide_row_left(row) for row in board]

def slide_right(board):
    #slides all of the tiles to the right and then returns a new board
    reversed_board = reverse_rows(board)
    slid = slide_left(reversed_board)
    return reverse_rows(slid)

def slide_up(board):
    #slides all the tiles up and then returns the new board
    transposed = transpose(board)
    slid = slide_left(transposed)
    return transpose(slid)

def slide_down(board):
    #slides all of the tiles down snd returns the new board
    transposed = transpose(board)
    slid = slide_right(transposed)   # slide right on transposed = slide down
    return transpose(slid)


# Check the state of the game (e.g. game wins, game over)
def check_win(board):
    #will return True if any of the cells on the board contains 2048 and the player wins
    for row in board:
        for cell in row:
            if cell == 2048:
                return True
    return False

def check_game_over(board):
    """
    Returns True if no moves are possible (the game is lost).

    The game is over when:
      1. There are no empty cells left, AND
      2. No two adjacent tiles (horizontally or vertically) are equal.
    If either condition fails, at least one move still exists.
    """
    # If any cell is empty, the game is not over
    if get_empty_cells(board):
        return False

    # Check every cell for a mergeable neighbor to the right or below
    for row in range(4):
        for col in range(4):
            # Check right neighbor
            if col + 1 < 4 and board[row][col] == board[row][col + 1]:
                return False
            # Check bottom neighbor
            if row + 1 < 4 and board[row][col] == board[row + 1][col]:
                return False

    # No empty cells and no merges available — game over
    return True


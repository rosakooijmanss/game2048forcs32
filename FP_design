def slide_row_left(row):
    """
    Slides all nonzero tiles in a row to the left,
    then merges adjacent equal tiles.
    Returns the new row.
    
    Example: [0, 2, 2, 4] -> [4, 4, 0, 0]
    """
    # Step 1: Remove zeros (compact the row)
    tiles = []
    for val in row:
        if val != 0:
            tiles.append(val)
    
    # Step 2: Merge adjacent equal tiles
    merged = []
    i = 0
    while i < len(tiles):
        if i + 1 < len(tiles) and tiles[i] == tiles[i + 1]:
            merged.append(tiles[i] * 2)   # merge
            i += 2                         # skip both
        else:
            merged.append(tiles[i])
            i += 1
    
    # Step 3: Pad with zeros to restore length 4
    while len(merged) < 4:
        merged.append(0)
    
    return merged
